# ── OpenArg Backend — Environment Variables ─────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
# Generate secrets:
#   openssl rand -base64 32   (for NEXTAUTH_SECRET)
#   openssl rand -base64 24   (for BACKEND_API_KEY, ADMIN_API_KEY)
#   openssl rand -base64 32   (for POSTGRES_PASSWORD, REDIS_PASSWORD)
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=openarg
POSTGRES_PASSWORD=
POSTGRES_DB=openarg_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── AI Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Frontend (NextAuth + Google OAuth) ────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://openarg.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# ── Security ─────────────────────────────────────────────────
BACKEND_API_KEY=
CORS_ALLOWED_ORIGINS=https://openarg.org
SANDBOX_DATABASE_URL=
SANDBOX_POSTGRES_PASSWORD=
ADMIN_EMAILS=

# ── Flower ───────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=

# ── App ───────────────────────────────────────────────────────
APP_ENV=prod

# ── Security Tuning (defaults are fine for most deployments) ──
# INJECTION_THRESHOLD=0.6
# CACHE_SIMILARITY_THRESHOLD=0.92
# SANDBOX_MAX_ROWS=1000
# SANDBOX_TABLE_PREFIX=cache_
# SANDBOX_TIMEOUT_MS=10000

# ── Parser Hardening (specs/021) ──────────────────────────────
# Generic unpivot in `_post_parse_normalize` (collector path).
# Default ON — set to "0" to disable globally.
# OPENARG_GENERIC_UNPIVOT=1
#
# Override the cap of `live_tables_by_*` macros in mart YAMLs.
# Default 200; raise for marts that legitimately need more (e.g.
# `presupuesto_nacional_ejecutado` was 32-out-of-533 before the
# `require_all_columns=True` flag took over). Kept as emergency knob.
# OPENARG_MART_MAX_UNION_TABLES=200

# ── LLM Re-ranker (FIX-027) ───────────────────────────────────
# Activates the LLM re-ranker over planner candidates.
# Default OFF; set to "1" to enable.
# OPENARG_ENABLE_LLM_RERANKER=0
#
# Shadow-mode runs the re-ranker without changing served candidates
# (logs the proposed reorder for evaluation). Default OFF.
# OPENARG_LLM_RERANKER_SHADOW_MODE=0
#
# Cap on how many top candidates the re-ranker considers per query.
# Default 8 — increasing costs more LLM tokens per query.
# OPENARG_RERANKER_MAX_CANDIDATES=8

# ── Probes / opt-ins ──────────────────────────────────────────
# Head-size probe: counts rows of the first chunk during ingest
# to flag undersized partitions early.
# OPENARG_ENABLE_HEAD_SIZE_PROBE=0
#
# Raw retention — how many raw versions per resource_identity to keep
# before `retain_raw_versions` drops the older ones.
# Default 2 (one rollback step). Lower = more disk savings.
# OPENARG_RAW_RETENTION_KEEP_LAST=2
