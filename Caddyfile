# Frontend
{$DOMAIN:openarg.org} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://{$API_DOMAIN:api.openarg.org} wss://{$API_DOMAIN:api.openarg.org}; font-src 'self' data:; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy frontend:3000
}

# Backend API
{$API_DOMAIN:api.openarg.org} {
	encode gzip zstd

	header {
		Access-Control-Allow-Origin https://{$DOMAIN:openarg.org}
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, X-API-Key, X-User-Email"
		Access-Control-Max-Age 86400
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options DENY
	}

	@options method OPTIONS
	respond @options 204

	# SECURITY: Block admin/docs endpoints in production
	@blocked path /docs /docs/* /redoc /openapi.json /api/v1/admin/*
	respond @blocked 404


	reverse_proxy backend:8080
}

# MCP público de datos + su web (spec 029). Sin el CORS del bloque de la API:
# los clientes MCP no son navegadores de openarg.org.
{$MCP_DOMAIN:mcp.openarg.org} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy mcp:8000 {
		flush_interval -1
	}
}
